{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofgrid:schema:rule-pack:0.1",
  "title": "ProofGrid partial Rule Pack v0.1",
  "$comment": "SPDX-License-Identifier: MPL-2.0; constraint keyword validity and citation references require evaluator checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pack_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "product_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "product_type",
        "models"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "effective": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "known"
            },
            "from": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
            },
            "until": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
            }
          },
          "required": [
            "status",
            "from"
          ]
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "document_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewed_at": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
          }
        },
        "required": [
          "source_id",
          "title",
          "url",
          "document_version",
          "reviewed_at"
        ]
      },
      "minItems": 1
    },
    "coverage": {
      "const": "partial"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "classification": {
            "enum": [
              "required",
              "conditional",
              "contextual"
            ]
          },
          "status": {
            "enum": [
              "executable",
              "unresolved"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "source_id",
                "locator"
              ]
            },
            "minItems": 1
          },
          "constraint": {
            "type": "object",
            "minProperties": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "rule_id",
          "description",
          "classification",
          "status",
          "citations"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "executable"
                }
              }
            },
            "then": {
              "required": [
                "constraint"
              ],
              "properties": {
                "classification": {
                  "const": "required"
                }
              },
              "not": {
                "required": [
                  "reason"
                ]
              }
            },
            "else": {
              "required": [
                "reason"
              ],
              "not": {
                "required": [
                  "constraint"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "version",
          "reviewed_at",
          "summary"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "manufacturer",
    "product_scope",
    "jurisdiction",
    "effective",
    "sources",
    "coverage",
    "limitations",
    "rules",
    "revision_history"
  ]
}
